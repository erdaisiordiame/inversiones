{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "framework": "vite",
  "env": {
    "VITE_MONGO_URI": "@mongo_uri",
    "VITE_MONGO_DB_NAME": "@mongo_db_name",
    "VITE_FINNHUB_API_KEY": "@finnhub_api_key"
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "https://inversiones-production-3f4e.up.railway.app/api/$1"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
